{
  "expo": {
    "name": "PitWall Lap",
    "slug": "pitwall-lap",
    "version": "1.16.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0d13"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PitWall se conecta al cronómetro de tu pista (DS-300 o InfoLap) en la WiFi local para mostrar los tiempos en vivo.",
        "NSMicrophoneUsageDescription": "PitWall Lap usa el micrófono para que hables con tu equipo en Radio.",
        "NSBonjourServices": [
          "_pitwall-manager._tcp",
          "_pitwall-radio._tcp"
        ],
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "es.pitwall.lap"
    },
    "android": {
      "package": "com.anonymous.pitwalllap",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#0a0d13"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "PitWall Lap usa el micrófono para que hables con tu equipo en Radio."
        }
      ],
      "./plugins/withScriptSandboxDisabled.js",
      "./plugins/withFmtConstevalFix.js",
      "./plugins/withAndroidCleartextTraffic.js",
      "./plugins/withWebrtcPermissions.js",
      "./plugins/withSceneLifecycle.js",
      "expo-asset",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "PitWall Lap usa la cámara para que puedas fotografiar los resultados de una carrera.",
          "microphonePermission": "PitWall Lap usa el micrófono para que hables con tu equipo en Radio.",
          "photosPermission": "PitWall Lap accede a tus fotos para que puedas añadir resultados de una carrera."
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withoutPush.js"
    ],
    "extra": {
      "eas": {
        "projectId": "7de36662-a4c6-4399-aeee-ab297c740bdf"
      }
    },
    "owner": "victorggomez"
  }
}

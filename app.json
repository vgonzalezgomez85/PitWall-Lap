{
  "expo": {
    "name": "PitWall Lap",
    "slug": "pitwall-lap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0d13"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PitWall se conecta al cronómetro de tu pista (DS-300 o InfoLap) en la WiFi local para mostrar los tiempos en vivo.",
        "NSBonjourServices": [
          "_pitwall-manager._tcp"
        ],
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "bundleIdentifier": "com.anonymous.pitwall-lap"
    },
    "android": {
      "package": "com.anonymous.pitwalllap",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#0a0d13"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "./plugins/withScriptSandboxDisabled.js",
      "./plugins/withAndroidCleartextTraffic.js",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "7de36662-a4c6-4399-aeee-ab297c740bdf"
      }
    },
    "owner": "victorggomez"
  }
}

{
  "name": "pitwall-lap",
  "version": "1.13.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "changelog:sync": "node scripts/sync-changelog.js",
    "apk": "bash scripts/build-apk.sh",
    "ios:testflight": "bash scripts/build-ios.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.2.3",
    "@react-navigation/native-stack": "^7.14.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-localization": "~17.0.9",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-tts": "^4.1.1",
    "react-native-udp": "^4.1.7",
    "react-native-webrtc": "^155.0.0",
    "react-native-zeroconf": "^0.14.0",
    "socket.io-client": "^4.8.3",
    "typescript": "~5.9.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
